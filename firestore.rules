rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isProfessorAdmin() {
      return isSignedIn() && adminData().role in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return isSignedIn() && adminData().role == 'superadmin';
    }

    function isKnownAgendaTurma(turmaId) {
      return turmaId in ['2° TECH D', '2° TECH E', '2° TECH F', '2° TECH G', '2° TECH H', '2° TECH I'];
    }

    function canClaimRepresentativeAccess(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/representativeInvites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/representativeInvites/$(request.auth.token.email.lower())).data.email == request.auth.token.email.lower()
        && isKnownAgendaTurma(get(/databases/$(database)/documents/representativeInvites/$(request.auth.token.email.lower())).data.turmaId)
        && request.resource.data.keys().hasOnly(['role', 'turmaId', 'createdAt'])
        && request.resource.data.keys().hasAll(['role', 'turmaId', 'createdAt'])
        && request.resource.data.role == 'representante'
        && request.resource.data.turmaId == get(/databases/$(database)/documents/representativeInvites/$(request.auth.token.email.lower())).data.turmaId
        && request.resource.data.createdAt == request.time;
    }

    function isRepresentanteOf(turmaId) {
      return isSignedIn()
        && adminData().role == 'representante'
        && adminData().turmaId == turmaId;
    }

    function canManage(turmaId) {
      return isSuperAdmin() || isRepresentanteOf(turmaId);
    }

    function isAnyAgendaAdmin() {
      return isSignedIn() && adminData().role in ['representante', 'superadmin'];
    }

    function canManageActivity(data) {
      return data.turmaId == null
        ? (isSuperAdmin() || (isSignedIn() && data.createdBy == request.auth.uid))
        : canManage(data.turmaId);
    }

    function canCreateActivity(data) {
      return data.createdBy == request.auth.uid
        && (data.turmaId == null ? isAnyAgendaAdmin() : canManage(data.turmaId));
    }

    function hasActivityShape(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.type in ['tarefa', 'licao', 'trabalho', 'prova', 'evento']
        && (data.subject == null || (data.subject is string && data.subject.size() > 0 && data.subject.size() <= 120))
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.time == null || (data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (data.turmaId == null || (data.turmaId is string && data.turmaId.size() > 0));
    }

    function isValidSuggestion(data) {
      return hasActivityShape(data)
        && data.turmaId is string && data.turmaId.size() > 0
        && data.status == 'pendente'
        && data.createdAt == request.time;
    }

    function isValidFeedback(data) {
      return data.keys().hasOnly(['message', 'turmaId', 'createdAt', 'createdBy', 'createdByEmail'])
        && data.keys().hasAll(['message', 'turmaId', 'createdAt', 'createdBy', 'createdByEmail'])
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && (data.turmaId == null || (data.turmaId is string && data.turmaId.size() > 0))
        && data.createdBy == request.auth.uid
        && request.auth.token.email is string
        && data.createdByEmail == request.auth.token.email
        && data.createdAt == request.time;
    }

    function isValidAnnouncement(data) {
      return data.message is string && data.message.size() > 0 && data.message.size() <= 500
        && data.updatedAt == request.time;
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if canClaimRepresentativeAccess(uid);
      allow list, update, delete: if false;
    }

    match /representativeRequests/{requestId} {
      // O ID aleatório é o código que o solicitante guarda para consultar o status.
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'turmaId', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'turmaId', 'status', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        && isKnownAgendaTurma(request.resource.data.turmaId)
        && request.resource.data.status == 'pendente'
        && request.resource.data.createdAt == request.time;
      allow update: if isSuperAdmin()
        && resource.data.status == 'pendente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['aprovada', 'rejeitada']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    match /representativeInvites/{email} {
      allow get: if (isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['email', 'turmaId', 'requestId', 'approvedAt'])
        && request.resource.data.keys().hasAll(['email', 'turmaId', 'requestId', 'approvedAt'])
        && request.resource.data.email == email
        && isKnownAgendaTurma(request.resource.data.turmaId)
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() == 20
        && request.resource.data.approvedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isProfessorAdmin();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow create: if hasActivityShape(request.resource.data)
        && canCreateActivity(request.resource.data);
      allow update: if canManageActivity(resource.data)
        && (request.resource.data.turmaId == null ? isAnyAgendaAdmin() : canManage(request.resource.data.turmaId))
        && hasActivityShape(request.resource.data);
      allow delete: if canManageActivity(resource.data);
    }

    // Enquetes por turma: representantes da turma ou super-admin publicam/encerram;
    // qualquer pessoa lê os resultados e cada UID registra só um voto imutável.
    function isValidPollOption(option) {
      return option is string && option.size() > 0 && option.size() <= 100;
    }

    function isValidPoll(data) {
      return data.keys().hasOnly(['turmaId', 'question', 'options', 'status', 'createdBy', 'createdAt'])
        && data.keys().hasAll(['turmaId', 'question', 'options', 'status', 'createdBy', 'createdAt'])
        && isKnownAgendaTurma(data.turmaId)
        && data.question is string && data.question.size() > 0 && data.question.size() <= 160
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 5
        && isValidPollOption(data.options[0]) && isValidPollOption(data.options[1])
        && (data.options.size() < 3 || isValidPollOption(data.options[2]))
        && (data.options.size() < 4 || isValidPollOption(data.options[3]))
        && (data.options.size() < 5 || isValidPollOption(data.options[4]))
        && data.status == 'open'
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    match /polls/{pollId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && canManage(request.resource.data.turmaId)
        && isValidPoll(request.resource.data);
      allow update: if canManage(resource.data.turmaId)
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'closed';
      allow delete: if false;

      match /votes/{voterUid} {
        allow get, list: if true;
        allow create: if isSignedIn()
          && request.auth.uid == voterUid
          && get(/databases/$(database)/documents/polls/$(pollId)).data.status == 'open'
          && request.resource.data.keys().hasOnly(['optionIndex', 'createdAt'])
          && request.resource.data.keys().hasAll(['optionIndex', 'createdAt'])
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0
          && request.resource.data.optionIndex < get(/databases/$(database)/documents/polls/$(pollId)).data.options.size()
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /suggestions/{suggestionId} {
      allow get: if true;
      allow list: if canManage(resource.data.turmaId);
      allow create: if isValidSuggestion(request.resource.data);
      allow update: if canManage(resource.data.turmaId)
        && (
          (resource.data.status == 'pendente'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['aprovada', 'rejeitada'])
          ||
          (resource.data.status in ['aprovada', 'rejeitada']
            && !resource.data.keys().hasAny(['closedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolution', 'reviewComment', 'closedAt'])
            && request.resource.data.keys().hasAll(['resolution', 'reviewComment', 'closedAt'])
            && request.resource.data.resolution in ['feito', 'nao_feito']
            && request.resource.data.reviewComment is string
            && request.resource.data.reviewComment.size() > 0
            && request.resource.data.reviewComment.size() <= 500
            && request.resource.data.closedAt == request.time)
        );
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && isValidFeedback(request.resource.data);
      allow get, list, delete: if isSuperAdmin();
      allow update: if false;
    }

    match /announcement/{announcementId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSuperAdmin() && isValidAnnouncement(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Caderno Infinito: leitura pública; publicação autenticada e edição apenas pelo autor.
    function isValidNotebookNote(data) {
      return data.keys().hasOnly(['title', 'content', 'subject', 'className', 'authorUid', 'authorEmail', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'content', 'subject', 'className', 'authorUid', 'authorEmail', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 120
        && data.className is string && data.className.size() <= 32
        && data.authorUid is string && data.authorEmail is string
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /notebookNotes/{noteId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && request.auth.token.email is string
        && isValidNotebookNote(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'subject', 'className', 'updatedAt'])
        && isValidNotebookNote(request.resource.data);
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }
  }
}
